# Copy to .env and fill in. `cp .env.example .env` is all that's needed.

# ---- Application
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Logs every SQL statement and its bound parameters (player UUIDs, guessed
# words) to stdout. Debugging only - leave this off in a deployment.
SQL_ECHO=false

# ---- Database (required)
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/arabic_semantic_game"

# ---- CORS: JSON array of allowed frontend origins
CORS_ORIGINS='["http://localhost:3000"]'

# ---- Embedding model (downloaded from Hugging Face on first start, ~500MB)
ML_MODEL_NAME="silma-ai/silma-embedding-matryoshka-v0.1"

# ---- Word seeding
# Ships with a 10-word sample so a fresh clone is playable. Point this at your
# own list for a real deployment - see docs/word-pool.md.
WORD_SEED_FILE="data/words.sample.json"

# ---- Hints
MAX_HINTS_PER_USER=3

# ---- Rate limiting
# When true, Redis is REQUIRED. Set to false for local work without Redis.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI="redis://localhost:6379"

# Read by uvicorn, not by the app. Requests are bucketed by the IP uvicorn
# reports; X-Forwarded-For is never trusted on its own. If a proxy sits in front
# of the API, set this to the proxy's address or every visitor shares one
# bucket. Never "*". See docs/configuration.md#behind-a-proxy.
# FORWARDED_ALLOW_IPS="127.0.0.1"

# ---- Error tracking (optional; leave empty to disable Sentry)
SENTRY_DSN=
